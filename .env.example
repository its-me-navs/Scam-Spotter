# Copy this file to ".env" and fill in your values. Never commit .env (it is git-ignored).

# --- Option A: Gemini or Groq (via the OpenAI-compatible route) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=your-key-here
LLM_MODEL=model-name-from-the-provider
# Gemini:
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Groq (use this line instead of the Gemini one):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Option B: Anthropic ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here
# LLM_MODEL=model-name

# --- Later, to show Phase 2 as well ---
# SCAMSPOTTER_PHASES=llm,retrieval
